# Required for Gemini-powered features
GEMINI_API_KEY=PUT_GEMINI_API_KEY
# Optional stable model override — defaults to gemini-2.5-flash in services/ai_service.py.
# Set this only to override the default, e.g. to pin a specific stable release.
# GENFORGE_GEMINI_MODEL=gemini-2.5-flash

# --- Production deployment (docker compose reads this file) -----------------
# Publishing platform tokens referenced as "env:NAME" in the Publishing UI.
# Uncomment and fill only the platforms you actually connect:
# YOUTUBE_ACCESS_TOKEN=
# INSTAGRAM_ACCESS_TOKEN=
# TIKTOK_ACCESS_TOKEN=
# LINKEDIN_ACCESS_TOKEN=
# Optional n8n webhook for publication notifications (must be http/https,
# never embed credentials in the URL):
# N8N_WEBHOOK_URL=
# Browser origin allowed by the Streamlit CORS/XSRF layer in production
# (set to your real domain, including scheme):
# GENFORGE_ALLOWED_ORIGIN=https://app.example.com